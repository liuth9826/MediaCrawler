# Proxy Configuration (Wandou HTTP)
# your_wandou_http_app_key
WANDOU_APP_KEY=

# Proxy Configuration (Kuaidaili)
# your_kuaidaili_secret_id
KDL_SECERT_ID=
# your_kuaidaili_signature
KDL_SIGNATURE=
# your_kuaidaili_username
KDL_USER_NAME=
# your_kuaidaili_password
KDL_USER_PWD=

# Proxy Configuration (Jisu HTTP)
# Get JiSu HTTP IP extraction key value
jisu_key=
# Get JiSu HTTP IP extraction encryption signature
jisu_crypto=

# ---------------------------------------------------------------------------
# 穿搭趋势分析：图片分析用的模型凭据（切片 5）
# ---------------------------------------------------------------------------
# 复制本文件为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会进仓库。
# 留空 = 不启用图片分析：`trend analyze` 会记一条「因缺凭据跳过」并照常出报告，
# 报告声明「本轮未运行图片分析」，绝不会给没有图片支撑的风格结论。
#
# 走 OpenAI 兼容接口（/chat/completions），模型必须支持图片输入。
#   OpenAI：TREND_LLM_BASE_URL=https://api.openai.com/v1
#           TREND_LLM_MODEL=gpt-4o
#   智谱：  TREND_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#           TREND_LLM_MODEL=glm-4v-plus
#   通义：  TREND_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#           TREND_LLM_MODEL=qwen-vl-max
#   豆包：  TREND_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#           TREND_LLM_MODEL=<你的接入点ID>
# 缺省 base_url 为 https://api.openai.com/v1。
TREND_LLM_API_KEY=
TREND_LLM_MODEL=
TREND_LLM_BASE_URL=

# 成本上限（留空则用默认值）：只分析榜单前 N 条、每帖最多送 K 张图。
TREND_VISION_TOP_N=20
TREND_VISION_MAX_IMAGES=4
